#!/bin/bash

# source: https://docs.xfce.org/xfce/tumbler/available_plugins#customized_thumbnailer_for_text-based_documents

iFile="$2"
oFile="$3"

extension="${iFile##*.}"

rm -f "$oFile"

head -50 "$iFile" | silicon \
  --no-window-controls \
  --font "JetBrainsMono Nerd Font=12" \
  --pad-horiz 0 --pad-vert 0 \
  --output "$oFile" 2>/dev/null

# if it cannot find the language based on the first 50 lines
# specify the language
if [[ ! -f "$oFile" ]]; then
    head -50 "$iFile" | silicon \
      --no-window-controls \
      --language "$extension" \
      --font "JetBrainsMono Nerd Font=12" \
      --pad-horiz 0 --pad-vert 0 \
      --output "$oFile" 2>/dev/null
fi

# if it still cannot find the language then no syntax highlighting
if [[ ! -f "$oFile" ]]; then
    tempFile=$(mktemp)
    head -50 "$iFile" > "$tempFile"
    magick -size 210x290 -background '#1e1e2e' -fill white -font JetBrainsMono-NF-Regular -pointsize 12 \
        -bordercolor '#1e1e2e' caption:@"$tempFile" -border 30x30 "$oFile"
    rm "$tempFile"
    # don't resize
    exit
fi

# mogrify -gravity NorthWest -crop 210x290+0+0 -extent 210x290 -background '#aaaaff' "$oFile"
mogrify -gravity NorthWest -crop 420x580+0+0 -resize 210x290 -extent 210x290 -background '#aaaaff' "$oFile"

